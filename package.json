{
  "name": "keypin",
  "version": "0.39.0",
  "private": true,
  "description": "Key syncs and rotation for the vault you already use. keypin rotates your keys at their provider and publishes them to your CI and hosting.",
  "homepage": "https://github.com/caiopizzol/keypin#readme",
  "bugs": {
    "url": "https://github.com/caiopizzol/keypin/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caiopizzol/keypin.git"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "check": "vp check && ! git grep --untracked -nE '(oxlint|eslint)-(disable|enable)' -- '*.ts' && sh scripts/check-lockfile.sh && sh scripts/check-typescript-only.sh && bun scripts/check-action-pins.ts && bun scripts/check-connectors.ts && bun scripts/check-provider-literals.ts && bun scripts/check-file-size.ts && bun scripts/check-docs-growth.ts",
    "test": "bun --bun vp test",
    "check-recordings": "bun scripts/check-recordings.ts",
    "typecheck": "vp run -r typecheck && tsc -p scripts",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@keypin/connectors": "workspace:*",
    "@keypin/core": "workspace:*",
    "@types/bun": "1.4.4",
    "@types/mdast": "4.0.4",
    "github-slugger": "2.0.0",
    "mdast-util-to-string": "4.0.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "typescript": "7.0.2",
    "unified": "11.0.5",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "overrides": {
    "vite": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.4",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "catalog": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.5.1",
    "vite-plus": "1.5.1"
  }
}
